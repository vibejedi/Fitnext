# ---- Supabase (backend: auth + database + storage) ----
# Create a free project at https://supabase.com, then Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret key — required for username/password signup
# (Project Settings → API keys → secret key). Never exposed to the browser.
SUPABASE_SECRET_KEY=
#
# REQUIRED DASHBOARD SETTING: Authentication → Sign In / Providers → Email →
# turn OFF "Secure email change". Training-only accounts hold a synthetic
# address on a domain that doesn't resolve; leaving the setting on makes
# Supabase confirm from that address too, and every email claim fails.

# ---- Claude (live AI coach). Without this the coach runs in demo/mock mode. ----
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-sonnet-4-6)
FITNEXT_MODEL=claude-sonnet-4-6

# ---- Strava (watch-activity import: Garmin/Apple/Coros sync via Strava) ----
# Create an API app at https://www.strava.com/settings/api
# Authorization Callback Domain = your deploy host (e.g. fitnext.tech)
NEXT_PUBLIC_STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Any random string; used to validate the webhook subscription handshake
STRAVA_VERIFY_TOKEN=

# ---- Privy (Solana wallet sign-in at the gate) ----
# Create an app at https://dashboard.privy.io — enable Wallet login, Solana.
# Without these the wallet button simply doesn't render.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Optional extra secret for deriving wallet-account passwords; defaults to
# SUPABASE_SECRET_KEY when unset. Changing it strands existing wallet accounts.
WALLET_AUTH_PEPPER=
